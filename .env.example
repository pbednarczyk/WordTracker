# RabbitMQ is required for all UI enrichment.
RABBITMQ_ENABLED=true
RABBITMQ_HOST=dexter
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/wordtracker
RABBITMQ_USER=wordtracker
RABBITMQ_PASSWORD=

LLM_JOBS_QUEUE=llm.jobs
LLM_RESULTS_QUEUE=llm.results
LLM_JOBS_API_TOKEN=

# Async UI enrichment. Set a strong shared secret locally.
ASYNC_ENRICHMENT_MODEL=qwen3:14b
ASYNC_ENRICHMENT_PROVIDER=ollama
ENRICHMENT_INTERNAL_TOKEN=
ENRICHMENT_APP_BASE_URL=http://nginx-dev
