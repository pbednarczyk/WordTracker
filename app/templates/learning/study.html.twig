{% extends 'base.html.twig' %}

{% block title %}Study - WordTracker{% endblock %}

{% block body %}
    <section class="page-header">
        <div>
            <h1>Study</h1>
            <p class="muted">{{ selectedCount }} cards selected</p>
        </div>
        <div class="actions">
            <a class="button" href="{{ path('learning_reviews') }}">Review History</a>
            <a class="button" href="{{ path('learning_cards') }}">Learning Cards</a>
        </div>
    </section>

    <section class="panel">
        <form class="filter-panel" method="get" action="{{ path('learning_study') }}">
            <input type="hidden" name="start" value="1">
            <label>
                Type
                <select name="type">
                    <option value="all">All</option>
                    {% for type in types %}
                        <option value="{{ type.value }}">{{ type.value }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Publication
                <select name="publication">
                    <option value="all">All</option>
                    {% for publication in publications %}
                        <option value="{{ publication.id }}">{{ publication.title }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Vocabulary status
                <select name="status">
                    <option value="all">All</option>
                    {% for status in statuses %}
                        <option value="{{ status.value|lower }}">{{ status.value }}</option>
                    {% endfor %}
                </select>
            </label>
            <button class="button" type="submit">Start</button>
        </form>
    </section>

    {% if card %}
        {% set enrichment = card.publicationVocabularyEnrichment %}
        {% set type = card.type.value %}
        <article class="study-card">
            <span class="badge badge--cards">{{ type }}</span>
            <p class="muted">Card {{ index + 1 }} of {{ total }} · {{ total - index - 1 }} remaining</p>
            {% if type == 'FORWARD' %}
                <p class="muted">What does this word mean?</p>
            {% elseif type == 'REVERSE' %}
                <p class="muted">Recall the target English word.</p>
            {% elseif type == 'CLOZE' %}
                <p class="muted">Recall the target expression for this cloze.</p>
            {% endif %}
            <div class="study-card__front">{{ card.front }}</div>

            {% if revealed %}
                <div class="study-card__answer">
                    <div>
                        <strong>Answer</strong>
                        {{ card.back }}
                    </div>
                    <div>
                        <strong>Target</strong>
                        {{ card.vocabularyItem.lemma }}
                    </div>
                    {% if enrichment %}
                        <div>
                            <strong>Translation</strong>
                            {{ enrichment.translationPl }}
                        </div>
                        <div>
                            <strong>Definition</strong>
                            {{ enrichment.definitionEn }}
                        </div>
                        <div>
                            <strong>Meaning in context</strong>
                            {{ enrichment.meaningInContext }}
                        </div>
                        <div>
                            <strong>Source sentence</strong>
                            {{ card.contextSentence ?: enrichment.sourceSentence }}
                        </div>
                        <div>
                            <strong>Simple example</strong>
                            {{ enrichment.simpleExample }}
                        </div>
                    {% endif %}
                </div>
                <form method="post" action="{{ path('learning_study_review') }}" data-rating-form>
                    <input type="hidden" name="_token" value="{{ csrf_token('learning_study') }}">
                    <input type="hidden" name="studySessionId" value="{{ studySessionId }}">
                    <input type="hidden" name="studyPosition" value="{{ index }}">
                    <input type="hidden" name="cardId" value="{{ card.id }}">
                    <div class="rating-grid">
                        {% for rating in ratings %}
                            {% set class = rating.value == 'AGAIN' ? 'button--danger' : (rating.value == 'HARD' ? 'button--warning' : (rating.value == 'GOOD' ? 'button--primary' : 'button--success')) %}
                            <button class="button rating-button {{ class }}" type="submit" name="rating" value="{{ rating.value }}" data-shortcut="{{ loop.index }}">
                                {{ rating.label() }}
                                <small>{{ rating.description() }}</small>
                            </button>
                        {% endfor %}
                    </div>
                </form>
            {% else %}
                <form method="post" action="{{ path('learning_study_reveal') }}" data-reveal-form>
                    <input type="hidden" name="_token" value="{{ csrf_token('learning_study') }}">
                    <input type="hidden" name="studySessionId" value="{{ studySessionId }}">
                    <input type="hidden" name="studyPosition" value="{{ index }}">
                    <input type="hidden" name="cardId" value="{{ card.id }}">
                    <button class="button button--primary" type="submit">Reveal answer</button>
                </form>
            {% endif %}
        </article>
    {% elseif selectedCount > 0 %}
        <div class="empty">
            <h2>Session complete</h2>
            {% if summary %}
                <div class="session-summary">
                    <div class="session-summary__item">
                        <span class="muted">Reviewed</span>
                        <strong>{{ summary.total }}</strong>
                    </div>
                    {% for rating in ratings %}
                        <div class="session-summary__item">
                            <span class="muted">{{ rating.label() }}</span>
                            <strong>{{ summary[rating.value] }}</strong>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            <div class="actions" style="margin-top: 18px;">
                <a class="button button--primary" href="{{ path('learning_study', { start: 1 }) }}">Start another session</a>
                <a class="button" href="{{ path('learning_reviews') }}">Review History</a>
            </div>
        </div>
    {% else %}
        <div class="empty">No active learning cards match the current filters.</div>
    {% endif %}

    <script>
        (() => {
            const interactiveSelector = 'input, select, textarea, button, a, label';
            let submitted = false;

            document.addEventListener('keydown', (event) => {
                if (submitted || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) {
                    return;
                }

                if (event.target instanceof Element && event.target.closest(interactiveSelector)) {
                    return;
                }

                const revealForm = document.querySelector('[data-reveal-form]');
                if (revealForm && (event.key === ' ' || event.key === 'Enter')) {
                    event.preventDefault();
                    submitted = true;
                    revealForm.requestSubmit();
                    return;
                }

                const ratingForm = document.querySelector('[data-rating-form]');
                if (!ratingForm || !['1', '2', '3', '4'].includes(event.key)) {
                    return;
                }

                const button = ratingForm.querySelector(`[data-shortcut="${event.key}"]`);
                if (!(button instanceof HTMLButtonElement)) {
                    return;
                }

                event.preventDefault();
                submitted = true;
                ratingForm.requestSubmit(button);
            });
        })();
    </script>
{% endblock %}
