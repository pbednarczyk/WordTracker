{% extends 'base.html.twig' %}

{% block title %}{{ item.lemma }} - WordTracker{% endblock %}

{% block body %}
    <section class="page-header">
        <div>
            <h1>{{ item.lemma }}</h1>
            <p class="muted">
                POS: {{ item.partOfSpeech }}
                &nbsp; Language: {{ item.language }}
                &nbsp; Status:
                <span class="badge {{ item.status.value == 'KNOWN' ? 'badge--known' : 'badge--unknown' }}">
                    {{ item.status.value }}
                </span>
            </p>
        </div>
        <form method="post" action="{{ path('vocabulary_status_update', { id: item.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('vocabulary_status_' ~ item.id) }}">
            <input type="hidden" name="redirectTo" value="vocabulary">
            {% if item.status.value == 'KNOWN' %}
                <button class="button" type="submit" name="status" value="UNKNOWN">Mark UNKNOWN</button>
            {% else %}
                <button class="button" type="submit" name="status" value="KNOWN">Mark KNOWN</button>
            {% endif %}
        </form>
    </section>

    <section class="grid">
        <div class="metric">
            <span class="metric__label">Total occurrences</span>
            <span class="metric__value">{{ summary.totalOccurrences }}</span>
        </div>
        <div class="metric">
            <span class="metric__label">Publications</span>
            <span class="metric__value">{{ summary.publicationCount }}</span>
        </div>
    </section>

    <section class="panel">
        <h2>AI Enrichment</h2>
        {% if publicationVocabulary is empty %}
            <p class="muted">No publication-specific vocabulary entries available.</p>
        {% else %}
            <div class="enrichment-list">
                {% for row in publicationVocabulary %}
                    {% set enrichment = row.enrichment %}
                    <article class="enrichment-card">
                        <div class="enrichment-card__header">
                            <div>
                                <strong>
                                    <a href="{{ path('publication_show', { id: row.publication.id }) }}">{{ row.publication.title }}</a>
                                </strong>
                                <div class="muted">{{ row.occurrences }} occurrence{{ row.occurrences == 1 ? '' : 's' }}</div>
                            </div>
                            <form method="post" action="{{ path('publication_vocabulary_enrich', { id: row.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('publication_vocabulary_enrichment_' ~ row.id) }}">
                                <button class="button button--small" type="submit">
                                    {{ enrichment ? 'Regenerate' : 'Generate enrichment' }}
                                </button>
                            </form>
                        </div>

                        {% if enrichment %}
                            {% set cardCount = row.id ? (cardCounts[row.id] ?? 0) : 0 %}
                            <div class="learning-card-actions">
                                <span class="badge {{ cardCount > 0 ? 'badge--cards' : 'badge--unknown' }}">
                                    {{ cardCount > 0 ? cardCount ~ ' cards generated' : 'No cards yet' }}
                                </span>
                                <form method="post" action="{{ path('publication_vocabulary_learning_cards_generate', { id: row.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('publication_vocabulary_learning_cards_' ~ row.id) }}">
                                    <button class="button button--small" type="submit">Generate learning cards</button>
                                </form>
                            </div>
                            <dl class="definition-list">
                                <div>
                                    <dt>Polish translation</dt>
                                    <dd>{{ enrichment.translationPl }}</dd>
                                </div>
                                <div>
                                    <dt>English definition</dt>
                                    <dd>{{ enrichment.definitionEn }}</dd>
                                </div>
                                <div>
                                    <dt>Meaning in this context</dt>
                                    <dd>{{ enrichment.meaningInContext }}</dd>
                                </div>
                                <div>
                                    <dt>Simple example</dt>
                                    <dd>{{ enrichment.simpleExample }}</dd>
                                </div>
                                <div>
                                    <dt>CEFR</dt>
                                    <dd>{{ enrichment.cefrLevel ?: '-' }}</dd>
                                </div>
                                <div>
                                    <dt>Source context</dt>
                                    <dd>{{ enrichment.sourceSentence }}</dd>
                                </div>
                                <div>
                                    <dt>Metadata</dt>
                                    <dd class="muted">
                                        {{ enrichment.provider ?: '-' }}
                                        {% if enrichment.model %} · {{ enrichment.model }}{% endif %}
                                        {% if enrichment.promptVersion %} · {{ enrichment.promptVersion }}{% endif %}
                                    </dd>
                                </div>
                            </dl>
                        {% else %}
                            <p class="muted">Generate enrichment first.</p>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section>
        <h2>Occurrence history</h2>
        {% if occurrences is empty %}
            <div class="empty">No occurrence history available.</div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Publication</th>
                        <th>Original form</th>
                        <th>Sentence</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    {% for occurrence in occurrences %}
                        <tr>
                            <td>
                                <a href="{{ path('publication_show', { id: occurrence.publication.id }) }}">
                                    {{ occurrence.publication.title }}
                                </a>
                            </td>
                            <td>{{ occurrence.originalForm }}</td>
                            <td>{{ occurrence.sentence ?: '-' }}</td>
                            <td>{{ occurrence.position is not null ? occurrence.position : '-' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}
