{% extends 'base.html.twig' %}

{% block title %}{{ publication.title }} - WordTracker{% endblock %}

{% block body %}
    <section class="page-header">
        <div>
            <h1>{{ publication.title }}</h1>
            <p class="muted">
                Type: {{ publication.type.value|capitalize }}
                &nbsp; Language: {{ publication.language }}
                &nbsp; Author: {{ publication.author ?: '-' }}
            </p>
        </div>
        <form method="post" action="{{ path('publication_analyze', { id: publication.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('analyze_publication_' ~ publication.id) }}">
            <button class="button button--primary" type="submit">
                {{ publication.analyzedAt ? 'Re-analyze' : 'Analyze publication' }}
            </button>
        </form>
    </section>

    {% if publication.analyzedAt %}
        <section class="grid">
            <div class="metric">
                <span class="metric__label">Unique vocabulary</span>
                <span class="metric__value">{{ summary.uniqueVocabulary }}</span>
            </div>
            <div class="metric">
                <span class="metric__label">Known</span>
                <span class="metric__value">{{ summary.knownVocabulary }}</span>
            </div>
            <div class="metric">
                <span class="metric__label">Unknown</span>
                <span class="metric__value">{{ summary.unknownVocabulary }}</span>
            </div>
            <div class="metric">
                <span class="metric__label">Vocabulary coverage</span>
                <span class="metric__value">{{ summary.vocabularyCoverage }}</span>
            </div>
            <div class="metric">
                <span class="metric__label">Text coverage</span>
                <span class="metric__value">{{ summary.textCoverage }}</span>
            </div>
            <div class="metric">
                <span class="metric__label">Vocabulary occurrences</span>
                <span class="metric__value">{{ summary.vocabularyOccurrences }}</span>
            </div>
            <div class="metric">
                <span class="metric__label">Analyzed at</span>
                <span class="metric__value">{{ publication.analyzedAt|date('Y-m-d H:i') }}</span>
            </div>
        </section>
    {% else %}
        <section class="panel">
            <h2>Status</h2>
            <p class="muted">Not analyzed</p>
        </section>
    {% endif %}

    {% if textPreview %}
        <section class="panel">
            <h2>Text preview</h2>
            <p class="preview">{{ textPreview }}</p>
            <a class="button" href="{{ path('publication_text', { id: publication.id }) }}">Read full text</a>
        </section>
    {% endif %}

    {% if publication.analyzedAt %}
        <section>
            <h2>Vocabulary</h2>
            <div class="toolbar toolbar--stacked">
                <form class="filter-panel" method="get" action="{{ path('publication_show', { id: publication.id }) }}">
                    <input type="hidden" name="sort" value="{{ filters.sort }}">
                    <input type="hidden" name="direction" value="{{ filters.direction }}">
                    <input type="hidden" name="page" value="1">
                    <input type="hidden" name="perPage" value="{{ filters.perPage }}">

                    <label>
                        Search
                        <input type="search" name="q" value="{{ filters.q }}" placeholder="Search lemma">
                    </label>

                    <label>
                        Status
                        <select name="status">
                            {% for label, value in { 'All': 'all', 'Unknown': 'unknown', 'Known': 'known' } %}
                                <option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        Enriched
                        <select name="enriched">
                            {% for label, value in { 'All': 'all', 'Yes': 'yes', 'No': 'no' } %}
                                <option value="{{ value }}" {{ filters.enriched == value ? 'selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <label>
                        Part of Speech
                        <select name="pos">
                            <option value="all" {{ filters.pos == 'all' ? 'selected' : '' }}>All</option>
                            {% for pos in posOptions %}
                                <option value="{{ pos }}" {{ filters.pos == pos ? 'selected' : '' }}>{{ pos }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    <button class="button" type="submit">Apply</button>
                    <a class="button" href="{{ path('publication_show', { id: publication.id }) }}">Clear filters</a>
                </form>
                <div class="actions">
                    <a class="button" href="{{ path('publication_vocabulary_export_csv', exportParams) }}">Export CSV</a>
                    <a class="button" href="{{ path('publication_vocabulary_export_xlsx', exportParams) }}">Export XLSX</a>
                </div>
            </div>

            <div class="table-meta">
                <span>
                    Showing {{ pagination.firstItem() }}-{{ pagination.lastItem() }} of {{ pagination.totalItems }} words
                </span>
                <form class="per-page" method="get" action="{{ path('publication_show', { id: publication.id }) }}">
                    <input type="hidden" name="q" value="{{ filters.q }}">
                    <input type="hidden" name="status" value="{{ filters.status }}">
                    <input type="hidden" name="enriched" value="{{ filters.enriched }}">
                    <input type="hidden" name="pos" value="{{ filters.pos }}">
                    <input type="hidden" name="sort" value="{{ filters.sort }}">
                    <input type="hidden" name="direction" value="{{ filters.direction }}">
                    <input type="hidden" name="page" value="1">
                    <label>
                        Per page
                        <select name="perPage">
                            {% for option in perPageOptions %}
                                <option value="{{ option }}" {{ filters.perPage == option ? 'selected' : '' }}>{{ option }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <button class="button button--small" type="submit">Apply</button>
                </form>
            </div>

            {% if vocabulary is empty %}
                <div class="empty">
                    No vocabulary items match the current filters.
                    <a href="{{ path('publication_show', { id: publication.id }) }}">Clear filters</a>
                </div>
            {% else %}
                <form id="bulk-status-form" method="post" action="{{ path('vocabulary_bulk_status_update') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('vocabulary_bulk_status_' ~ publication.id) }}">
                    <input type="hidden" name="enrichmentToken" value="{{ csrf_token('vocabulary_bulk_enrichment_' ~ publication.id) }}">
                    <input type="hidden" name="learningCardsToken" value="{{ csrf_token('publication_learning_cards_' ~ publication.id) }}">
                    <input type="hidden" name="publicationId" value="{{ publication.id }}">
                    {% for name, value in hiddenTableState %}
                        <input type="hidden" name="{{ name }}" value="{{ value }}">
                    {% endfor %}
                </form>

                <div class="bulk-actions">
                    <label class="select-all">
                        <input type="checkbox" data-select-visible>
                        Select all {{ vocabulary|length }} on this page
                    </label>
                    <button class="button" type="submit" name="status" value="KNOWN" form="bulk-status-form">Mark selected as KNOWN</button>
                    <button class="button" type="submit" name="status" value="UNKNOWN" form="bulk-status-form">Mark selected as UNKNOWN</button>
                    <button class="button" type="submit" form="bulk-status-form" formaction="{{ path('vocabulary_bulk_enrich') }}">Enrich selected</button>
                    <button class="button" type="submit" form="bulk-status-form" formaction="{{ path('publication_learning_cards_generate_selected', { id: publication.id }) }}">Generate cards for selected</button>
                </div>

                <table>
                    <thead>
                        <tr>
                            <th class="checkbox-column">Select</th>
                            {% for sort, label in { 'lemma': 'Word', 'pos': 'POS', 'occurrences': 'Occurrences', 'status': 'Status', 'enriched': 'Enriched' } %}
                                {% set active = filters.sort == sort %}
                                <th aria-sort="{{ active ? (filters.direction == 'asc' ? 'ascending' : 'descending') : 'none' }}">
                                    <a class="sort-link" href="{{ path('publication_show', sortLinks[sort].params) }}" title="Sort by {{ label }}">
                                        {{ label }}
                                        {% if active %}
                                            <span aria-hidden="true">{{ (filters.direction == 'asc' ? '&uarr;' : '&darr;')|raw }}</span>
                                        {% endif %}
                                    </a>
                                </th>
                            {% endfor %}
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in vocabulary %}
                            {% set item = row.vocabularyItem %}
                            <tr class="vocabulary-row" data-vocabulary-row>
                                <td class="checkbox-column">
                                    <input type="checkbox" name="ids[]" value="{{ item.id }}" form="bulk-status-form" data-vocabulary-checkbox>
                                </td>
                                <td><a href="{{ path('vocabulary_show', { id: item.id }) }}">{{ item.lemma }}</a></td>
                                <td>{{ item.partOfSpeech }}</td>
                                <td>{{ row.occurrences }}</td>
                                <td>
                                    <span class="badge {{ item.status.value == 'KNOWN' ? 'badge--known' : 'badge--unknown' }}">
                                        {{ item.status.value }}
                                    </span>
                                </td>
                                <td>
                                    {% if row.enrichment %}
                                        <span class="badge badge--enriched">ENRICHED</span>
                                    {% else %}
                                        <span class="muted">No</span>
                                    {% endif %}
                                    {% set rowCardCount = row.id ? (cardCounts[row.id] ?? 0) : 0 %}
                                    {% if rowCardCount > 0 %}
                                        <span class="badge badge--cards">CARDS {{ rowCardCount }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <form method="post" action="{{ path('vocabulary_status_update', { id: item.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('vocabulary_status_' ~ item.id) }}">
                                        <input type="hidden" name="publicationId" value="{{ publication.id }}">
                                        {% for name, value in hiddenTableState %}
                                            <input type="hidden" name="{{ name }}" value="{{ value }}">
                                        {% endfor %}
                                        {% if item.status.value == 'KNOWN' %}
                                            <button class="button button--small" type="submit" name="status" value="UNKNOWN">Mark UNKNOWN</button>
                                        {% else %}
                                            <button class="button button--small" type="submit" name="status" value="KNOWN">Mark KNOWN</button>
                                        {% endif %}
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                {% if pagination.totalPages > 1 %}
                    <nav class="pagination" aria-label="Vocabulary pagination">
                        {% set previousParams = { id: publication.id }|merge(filters)|merge({ page: pagination.page - 1 }) %}
                        {% set nextParams = { id: publication.id }|merge(filters)|merge({ page: pagination.page + 1 }) %}
                        <a class="page-link {{ pagination.page == 1 ? 'page-link--disabled' : '' }}"
                           href="{{ pagination.page == 1 ? '#' : path('publication_show', previousParams) }}"
                           aria-disabled="{{ pagination.page == 1 ? 'true' : 'false' }}">Previous</a>

                        {% for pageNumber in paginationPages %}
                            {% if pageNumber is same as('gap-left') or pageNumber is same as('gap-right') %}
                                <span class="page-gap">...</span>
                            {% else %}
                                {% set pageParams = { id: publication.id }|merge(filters)|merge({ page: pageNumber }) %}
                                <a class="page-link {{ pagination.page == pageNumber ? 'page-link--active' : '' }}"
                                   href="{{ path('publication_show', pageParams) }}"
                                   aria-current="{{ pagination.page == pageNumber ? 'page' : 'false' }}">{{ pageNumber }}</a>
                            {% endif %}
                        {% endfor %}

                        <a class="page-link {{ pagination.page == pagination.totalPages ? 'page-link--disabled' : '' }}"
                           href="{{ pagination.page == pagination.totalPages ? '#' : path('publication_show', nextParams) }}"
                           aria-disabled="{{ pagination.page == pagination.totalPages ? 'true' : 'false' }}">Next</a>
                    </nav>
                {% endif %}
            {% endif %}
        </section>
    {% endif %}

    <script>
        const syncRowSelection = (checkbox) => {
            checkbox.closest('[data-vocabulary-row]')?.classList.toggle('is-selected', checkbox.checked);
        };

        document.querySelector('[data-select-visible]')?.addEventListener('change', (event) => {
            document.querySelectorAll('[data-vocabulary-checkbox]').forEach((checkbox) => {
                checkbox.checked = event.target.checked;
                syncRowSelection(checkbox);
            });
        });

        document.querySelectorAll('[data-vocabulary-checkbox]').forEach((checkbox) => {
            checkbox.addEventListener('change', () => syncRowSelection(checkbox));
        });

        document.querySelectorAll('[data-vocabulary-row]').forEach((row) => {
            row.addEventListener('click', (event) => {
                if (event.target.closest('button, a, input, select, textarea, label')) {
                    return;
                }

                const checkbox = row.querySelector('[data-vocabulary-checkbox]');
                checkbox.checked = !checkbox.checked;
                syncRowSelection(checkbox);
            });
        });
    </script>
{% endblock %}
