{% extends 'base.html.twig' %}

{% block title %}Publications - WordTracker{% endblock %}

{% block body %}
    <section class="page-header">
        <div>
            <h1>Publications</h1>
            <p class="muted">Texts added to your vocabulary index.</p>
        </div>
        <a class="button button--primary" href="{{ path('publication_new') }}">Add publication</a>
    </section>

    {% if publications is empty %}
        <section class="empty">
            <h2>No publications yet.</h2>
            <p class="muted">Add your first publication.</p>
            <a class="button button--primary" href="{{ path('publication_new') }}">Add publication</a>
        </section>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Vocabulary Coverage</th>
                    <th>Unknown</th>
                    <th>Text Coverage</th>
                    <th>Language</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                {% for publication in publications %}
                    {% set coverage = coverageByPublication[publication.id] ?? null %}
                    <tr>
                        <td>
                            <a href="{{ path('publication_show', { id: publication.id }) }}">{{ publication.title }}</a>
                            <div class="muted publication-meta">
                                {{ publication.author ?: '-' }} · {{ publication.type.value|capitalize }}
                            </div>
                        </td>
                        <td class="coverage-cell">
                            {% if publication.analyzedAt and coverage %}
                                <div class="coverage-head">
                                    <span>{{ coverage.vocabularyCoverage }}</span>
                                    {% if coverage.completed %}
                                        <span class="badge badge--known">COMPLETED</span>
                                    {% endif %}
                                </div>
                                {% if coverage.vocabularyCoveragePercent is not null %}
                                    <div class="progress progress--{{ coverage.vocabularyCoverageLevel }}" aria-label="Vocabulary Coverage {{ coverage.vocabularyCoverage }}">
                                        <div class="progress__bar" style="width: {{ coverage.vocabularyCoveragePercent }}%"></div>
                                    </div>
                                {% endif %}
                            {% elseif publication.analyzedAt %}
                                <span class="muted">No vocabulary</span>
                            {% else %}
                                <span class="muted">Not analyzed</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if publication.analyzedAt and coverage %}
                                Unknown: {{ coverage.unknownVocabulary }}
                            {% else %}
                                <span class="muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if publication.analyzedAt and coverage %}
                                <span class="muted">{{ coverage.textCoverage }}</span>
                            {% else %}
                                <span class="muted">-</span>
                            {% endif %}
                        </td>
                        <td>{{ publication.language }}</td>
                        <td>{{ publication.createdAt|date('Y-m-d') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
