{% extends 'base.html.twig' %}

{% block title %}WordTracker{% endblock %}

{% block body %}
    <section class="page-header">
        <div>
            <h1>WordTracker</h1>
            <p class="muted">Track the vocabulary you actually encounter.</p>
        </div>
        <div class="actions">
            <a class="button" href="{{ path('publication_index') }}">Publications</a>
            <a class="button button--primary" href="{{ path('publication_new') }}">Add publication</a>
        </div>
    </section>

    <section class="panel">
        <h2>System</h2>
        <dl class="grid">
            <div class="metric">
                <dt class="metric__label">Symfony</dt>
                <dd class="metric__value badge badge--known">OK</dd>
            </div>
            <div class="metric">
                <dt class="metric__label">PostgreSQL</dt>
                <dd class="metric__value badge {{ database_ok ? 'badge--known' : 'flash--error' }}">{{ database_ok ? 'OK' : 'ERROR' }}</dd>
            </div>
            <div class="metric">
                <dt class="metric__label">NLP service</dt>
                <dd class="metric__value badge {{ nlp_ok ? 'badge--known' : 'flash--error' }}">{{ nlp_ok ? 'OK' : 'ERROR' }}</dd>
            </div>
        </dl>
    </section>
{% endblock %}
