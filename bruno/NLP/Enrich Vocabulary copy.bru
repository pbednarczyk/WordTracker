meta {
  name: Enrich Vocabulary copy
  type: http
  seq: 4
}

post {
  url: {{nlpBaseUrl}}/enrich
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "lemma": "willingness",
    "part_of_speech": "NOUN",
    "original_form": "willingness",
    "context_sentence": "His willingness to grow and accept responsibility impressed everyone.",
    "source_language": "en",
    "target_language": "pl"
  }
}

assert {
  res.status: eq 200
  res.body.translation_pl: isString
  res.body.translation_pl: isNotEmpty
  res.body.definition_en: isString
  res.body.definition_en: isNotEmpty
  res.body.meaning_in_context: isString
  res.body.meaning_in_context: isNotEmpty
  res.body.simple_example: isString
  res.body.simple_example: isNotEmpty
  res.body.provider: eq ollama
  res.body.model: isString
  res.body.model: isNotEmpty
  res.body.prompt_version: eq word-enrichment-v2
}

tests {
  test("cefr_level is a valid CEFR value or null", function() {
    const body = res.getBody();
    expect(["A1", "A2", "B1", "B2", "C1", "C2", null]).to.include(body.cefr_level);
  });
}
