meta {
  name: Publish Prepared Enrichment Job
  type: http
  seq: 9
}

post {
  url: {{nlpBaseUrl}}/internal/enrichment/publish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Enrichment-Token: {{enrichmentInternalToken}}
}

body:json {
  {
    "schema_version": 1,
    "type": "llm.generate",
    "job_id": "00000000-0000-4000-8000-000000000001",
    "created_at": "2026-09-23T00:00:00Z",
    "model": "qwen3:14b",
    "prompt": "Replace this example with the exact job from stateless preparation.",
    "format": {
      "type": "object"
    },
    "options": {
      "temperature": 0.2
    }
  }
}

assert {
  res.status: eq 202
  res.body.status: eq queued
  res.body.job_id: isString
}

docs {
  Operator-only transport example. This publishes real work: do not include in unattended contract runs.
  Replace the entire example with the prepared job AFTER Symfony durably records its UUID.
  Normally only Symfony calls this route. Reusing a UUID does not deduplicate inference.
  202 means broker confirmation only. 401 invalid token; 422 invalid envelope; 503 disabled/unconfirmed/configuration failure.
  The Phase 2 diagnostic result consumer must be stopped while the production consumer is active.
}
